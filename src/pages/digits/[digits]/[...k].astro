---
import { env } from 'cloudflare:workers';
import Result from '../../../components/Result.astro';
import Base from '../../../layouts/Base.astro';
import { openIndex } from '../../../lib/index/r2-source';
import { buildResult, parseRequestedK } from '../../../lib/result';
import { RESULT_CACHE } from '../../../lib/respond';
import { staircase } from '../../../lib/staircase';

const { digits, k } = Astro.params;
if (!digits || !/^\d{1,40}$/.test(digits)) return new Response(null, { status: 404 });
if (k !== undefined && parseRequestedK(k) === undefined)
  return Astro.redirect(`/digits/${digits}`, 301);

const index = await openIndex(env.PI);
const tooLong = digits.length > index.manifest.maxQuery;
if (tooLong) Astro.response.status = 404;
else Astro.response.headers.set('Cache-Control', RESULT_CACHE);
const model = tooLong
  ? null
  : await buildResult(index, await staircase(index, Array.from(digits)), parseRequestedK(k));
---

<Base
  title={`${digits} in pi`}
  description={`Where the digits ${digits} first appear in pi.`}
  image={model ? `/og/digits/${digits}.png` : undefined}
>
  <header class="sequence">
    <h1><span class="digits">{digits}</span></h1>
    <p class="muted small">Each row adds one more digit of the string.</p>
  </header>
  {
    model ? (
      <Result model={model} base={`/digits/${digits}`} termLabel="digits" />
    ) : (
      <p class="headline">
        That string is longer than {index.manifest.maxQuery} digits. Strings past that length are
        effectively never found in the first billion digits, so the index stops there. Try a shorter
        prefix:{' '}
        <a href={`/digits/${digits.slice(0, index.manifest.maxQuery)}`} class="digits">
          {digits.slice(0, index.manifest.maxQuery)}
        </a>
        .
      </p>
    )
  }
</Base>
