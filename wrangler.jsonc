{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oeis-pi-search",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  "routes": [{ "pattern": "oeis-pi-search.dwainosaur.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB_A",
      "database_name": "oeis-pi-search",
      "database_id": "ae45f641-830c-42fe-8898-2319ac03f503",
    },
    {
      "binding": "DB_B",
      "database_name": "oeis-pi-search-b",
      "database_id": "be7b054f-3ebf-4323-afd4-eb842af5bc7b",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PI",
      "bucket_name": "oeis-pi-search",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "383d10f676c14d119af298763440044c",
    },
  ],
}
