{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oeis-pi-search",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  "routes": [{ "pattern": "oeis-pi-search.dwainosaur.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oeis-pi-search",
      "database_id": "ae45f641-830c-42fe-8898-2319ac03f503",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PI",
      "bucket_name": "oeis-pi-search",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "383d10f676c14d119af298763440044c",
    },
  ],
}
